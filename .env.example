# Defaults work with npm run dev/start. All browser requests use the same origin.
PORT=3000
BACKEND_PORT=8765
BACKEND_URL=http://127.0.0.1:8765
DATABASE_PATH=backend/zoom.db
# Set this to your deployed frontend URL for origin validation.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional TURN relay for calls across restrictive networks.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
